FROM to-be-replaced-by-local-ref/base:fedora-44

USER root:root

ENV GOPATH=/tmp/go \
    GOBIN=/usr/local/bin \
    GOROOT=/usr/local/go \
    GOTOOLCHAIN=local
ENV PATH=${PATH}:${GOROOT}/bin:${GOBIN}

COPY ./bin/* /usr/local/libexec/glasswing-images/
COPY ./lib/* /usr/local/lib/glasswing-images/

RUN microdnf update -y && \
    microdnf install -y git make gcc && \
    microdnf clean all && \
    rm -rf /var/cache/dnf/*
